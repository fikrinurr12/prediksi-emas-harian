# .streamlit/secrets.toml
#
# File ini berisi kunci rahasia (API key) dan TIDAK BOLEH di-commit ke GitHub
# (sudah dimasukkan ke .gitignore secara otomatis).
#
# Untuk pengembangan lokal:
#   1. Copy file ini, hapus akhiran ".example" sehingga jadi "secrets.toml"
#   2. Isi TWELVEDATA_API_KEY dengan API key asli dari twelvedata.com
#
# Untuk Streamlit Community Cloud:
#   1. Buka dashboard app kamu di share.streamlit.io
#   2. Klik menu (...) -> Settings -> Secrets
#   3. Paste isi berikut (dengan API key asli) ke kotak yang tersedia
#   4. Simpan -- aplikasi akan otomatis restart dan secrets langsung terbaca

TWELVEDATA_API_KEY = "isi_dengan_api_key_asli_dari_twelvedata"
